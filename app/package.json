{
  "name": "app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:today": "node ./node_modules/@playwright/test/cli.js test --config=playwright.today.config.ts",
    "test:scrum": "node --test tests/scrum-model.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "node ./node_modules/vite/bin/vite.js",
    "prebuild": "npm run check:runtime",
    "export:design-system": "node scripts/export-design-system.mjs",
    "check:design-system": "node scripts/export-design-system.mjs --check",
    "build": "node scripts/export-editorial-catalog.mjs && npm run export:design-system && node ./node_modules/typescript/bin/tsc && node ./node_modules/vite/bin/vite.js build && node scripts/prepare-sites-build.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/roboto": "5.2.10",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
